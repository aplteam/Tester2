 r←Test_Group_019(debugFlag batchFlag);⎕TRAP;T2;rc;log
⍝ `~` excludes exactly the given group; with a trailing `*` all groups starting with that string
 ⎕TRAP←(999 'C' '∘∘∘ ⍝ Deliberate error')(0 'N')
 r←T._Failed

 #.⎕SHADOW'Temp'
 'Temp'#.⎕NS''
 T2←⎕NEW ##.Tester2 #.Temp
 #.Temp.⎕FX'r←Test_Ab_01 x;⎕TRAP' 'r←0'
 #.Temp.⎕FX'r←Test_Abc_01 x;⎕TRAP' 'r←0'
 (rc log)←T2.RunThese'A*,~Ab'
 →T.PassesIf∨/'Test_Abc_01'⍷∊log
 →T.PassesIf~∨/'Test_Ab_01'⍷∊log
 (rc log)←T2.RunThese'A*,~Ab*'
 →T.PassesIf~∨/'Test_Ab'⍷∊log

 r←T._OK
