 r←Test_Misc_18(debugFlag batchFlag);⎕TRAP;T2;rc;log
⍝ A test function returning an invalid code (neither a symbolic name nor a custom code) is reported as broken
 ⎕TRAP←(999 'C' '∘∘∘ ⍝ Deliberate error')(0 'N')
 r←T._Failed

 #.⎕SHADOW'Temp'
 'Temp'#.⎕NS''
 T2←⎕NEW ##.Tester2 #.Temp
 #.Temp.⎕FX'r←Test_01 x;⎕TRAP' '⍝ Returns an invalid code' 'r←2'
 (rc log)←T2.Run 0
 →T.PassesIf 1=rc
 →T.PassesIf∨/'1 test case broken'⍷∊log

 r←T._OK
